---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort(
    (a, b) => a.data.groupOrder - b.data.groupOrder || a.data.order - b.data.order,
  );

  return docs.map((entry, index) => ({
    params: { slug: entry.data.slug || undefined },
    props: {
      entry,
      docs,
      previous: docs[index - 1] ?? null,
      next: docs[index + 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
  docs: CollectionEntry<'docs'>[];
  previous: CollectionEntry<'docs'> | null;
  next: CollectionEntry<'docs'> | null;
}

const { entry, docs, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} docs={docs} headings={headings} previous={previous} next={next}>
  <Content />
</DocsLayout>
