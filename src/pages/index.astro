---
const title = 'Gungnir';
const description = 'Expressive web framework built in C++.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p>GUNGNIR</p>
      <h1>Expressive web framework built in C++.</h1>
      <p>The Gungnir website is now running on Astro.</p>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #ffffff;
    color: #071b33;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  :global(body) {
    margin: 0;
  }

  main {
    display: grid;
    min-height: 100vh;
    place-content: center;
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }

  p {
    margin: 0 0 1rem;
    color: #145da0;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 16ch;
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  h1 + p {
    max-width: 36rem;
    color: #5d6772;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.7;
    text-transform: none;
  }
</style>
