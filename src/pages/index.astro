---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeWorkbench from "../components/home/CodeWorkbench.astro";
import Icon from "../components/ui/Icon.astro";
import source from "../data/gungnir-source.json";
const features = [
  [
    "code",
    "Routes to real responses",
    "Named routes, middleware, model binding, validation and file uploads. Give every request a clear path.",
    "/docs/routing/",
    "HTTP & routing",
  ],
  [
    "database",
    "Work with your data",
    "Models, migrations and a typed ORM. Query records, eager load relationships and control what you expose.",
    "/docs/models/",
    "Models & ORM",
  ],
  [
    "window",
    "HTML, with Spear",
    "Build server-rendered pages with familiar HTML, escaped expressions, layouts and Blade-like directives.",
    "/docs/views/",
    "Views & templates",
  ],
  [
    "shield",
    "Access with intention",
    "Authenticate users, persist sessions and authorize operations with resource policies.",
    "/docs/auth/",
    "Authentication & policies",
  ],
  [
    "clock",
    "Work beyond the request",
    "Dispatch events, queue jobs, schedule recurring tasks and send application mail and notifications.",
    "/docs/queues/",
    "Jobs & application services",
  ],
  [
    "terminal",
    "Ready for the next step",
    "Configure adapters, inspect logs and telemetry, and deploy with explicit health checks and process supervision.",
    "/docs/production/",
    "Configuration & deployment",
  ],
];
const paths = [
  [
    "terminal",
    "Start a project",
    "Install the SDK, create an app and run it locally.",
    "/docs/getting-started/",
  ],
  [
    "code",
    "Learn the language",
    "Types, functions and the application building blocks.",
    "/docs/language/",
  ],
  [
    "book",
    "Find a guide",
    "Browse HTTP, data, security and service documentation.",
    "/docs/",
  ],
];
---

<BaseLayout
  title="Gungnir"
  description="An expressive C++23 web framework. Build native applications with .gnr models, controllers, routes, an ORM, Spear views and background jobs."
>
  <main id="main-content" class="homepage">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="site-container hero-grid">
        <div class="hero-copy">
          <a class="release-label" href="/docs/installation/">
            <span class="release-indicator" aria-hidden="true"></span>Gungnir{" "}
            {source.version}
            <span class="release-divider">/</span>Stable release
            <Icon name="external" size={15} />
          </a>
          <p class="eyebrow hero-eyebrow">The expressive C++23 web framework</p>
          <h1 id="hero-title">
            Expressive code.
            <br />
            <span>Native applications.</span>
          </h1>
          <p class="hero-description">
            Build your backend with familiar models, controllers and routes.
            Write it in <code>.gnr</code>. Run it as a native application.
          </p>
          <div class="hero-actions">
            <a class="button-primary" href="/docs/getting-started/">
              Start building
              <Icon name="arrow" size={18} />
            </a>
            <a class="button-secondary" href="/docs/">
              Read the docs
              <Icon name="book" size={17} />
            </a>
          </div>
          <p class="hero-footnote">
            For APIs, server-rendered web apps and backend services.
          </p>
        </div>
        <CodeWorkbench />
      </div>
    </section>
    <section class="start-strip" aria-labelledby="start-title">
      <div class="site-container start-strip-inner">
        <div>
          <p class="eyebrow">From the terminal</p>
          <h2 id="start-title">Your first application.</h2>
        </div>
        <div class="terminal-command">
          <span aria-hidden="true">$</span>
          <code>gungnir new hello</code>
          <a
            href="/docs/getting-started/"
            aria-label="View installation and first application instructions"
          >
            <Icon name="arrow" />
          </a>
        </div>
        <p>
          Install the SDK first.
          <br />
          <a href="/docs/sdk-packages/">
            Choose your package <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </section>
    <section
      class="capabilities-section site-container"
      aria-labelledby="capabilities-title"
    >
      <div class="section-intro">
        <p class="eyebrow">Build with Gungnir</p>
        <h2 id="capabilities-title">
          A framework for the
          <br />
          application you have in mind.
        </h2>
        <p>
          From the first route to background work.
          <br />
          Explore the pieces as you need them.
        </p>
      </div>
      <div class="capabilities-grid">
        {features.map(([icon, title, description, href, link]) => (
          <article class="capability">
            <Icon name={icon} size={26} />
            <h3>{title}</h3>
            <p>{description}</p>
            <a href={href}>
              {link}
              <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="data-section">
      <div class="site-container data-section-inner">
        <div>
          <p class="eyebrow">Your data, your choice</p>
          <h2>
            Connect the database
            <br />
            your application needs.
          </h2>
          <p>
            Use SQLite or configure a native adapter for your database. Models
            keep querying, relationships and serialization together.
          </p>
          <a class="text-link" href="/docs/database/">
            Database configuration
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="database-list" aria-label="Supported database adapters">
          {[
            ["SQLite", "/docs/sdk-packages/"],
            ["PostgreSQL", "/docs/postgresql/"],
            ["MySQL / MariaDB", "/docs/mysql/"],
            ["SQL Server", "/docs/sqlserver/"],
            ["MongoDB", "/docs/mongodb/"],
          ].map(([name, url]) => (
            <a href={url}>
              <span>{name}</span>
              <Icon name="external" size={18} />
            </a>
          ))}
          <p>
            Adapters require an SDK built with their dependencies. MongoDB
            retains document-database semantics.
          </p>
        </div>
      </div>
    </section>
    <section
      class="site-container learning-section"
      aria-labelledby="learn-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">The documentation</p>
          <h2 id="learn-title">Make your next move.</h2>
        </div>
        <a class="text-link" href="/docs/">
          All guides
          <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="learning-grid">
        {paths.map(([icon, title, detail, href]) => (
          <a class="learning-path" href={href}>
            <Icon name={icon} size={24} />
            <h3>{title}</h3>
            <p>{detail}</p>
            <Icon class="path-arrow" name="arrow" size={19} />
          </a>
        ))}
      </div>
      <aside class="sdk-note">
        <span class="note-label">SDK note</span>
        <p>
          Published {source.version} downloads contain the core SDK. Spear,
          typed delivery, and the SQLite/password application SDK require
          current source.{" "}
          <a href="/docs/sdk-packages/">
            Check feature availability and current installers.
          </a>
        </p>
      </aside>
    </section>
  </main>
</BaseLayout>
