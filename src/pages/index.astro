---
import BaseLayout from '../layouts/BaseLayout.astro';

const controllerExample = `controller UserController
{
    Response index()
    {
        const users = User::all();

        return view("users/index", {
            "users": users
        });
    }
}`;

const features = [
  ['01', 'Routing & Controllers', 'Map requests to focused controller actions with route parameters, middleware, and explicit async behavior.'],
  ['02', 'Models & Relationships', 'Query records, define relationships, eager load data, and keep database access readable and predictable.'],
  ['03', 'Validation', 'Validate incoming data at the request boundary before application or model code consumes it.'],
  ['04', 'Views', 'Render server-side HTML with escaped interpolation, loops, and model or collection data.'],
  ['05', 'Security', 'Handle sessions, authentication, authorization, CSRF protection, and request-level security concerns.'],
  ['06', 'Application Services', 'Coordinate events, queues, mail, notifications, cache, and scheduled work through explicit services.'],
];
---

<BaseLayout>
  <main id="main-content">
    <section class="relative overflow-hidden border-b border-gungnir-line bg-white dark:border-gungnir-dark-line dark:bg-gungnir-dark">
      <img
        src="/images/logo-alt.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute right-[-12%] top-1/2 hidden w-[58rem] -translate-y-1/2 select-none opacity-[0.025] grayscale dark:brightness-0 dark:invert dark:opacity-[0.035] lg:block"
      />
      <div class="absolute left-0 top-0 h-full w-1 bg-gungnir-blue" aria-hidden="true"></div>

      <div class="relative mx-auto grid w-full max-w-[1440px] items-center gap-14 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.08fr_.92fr] lg:gap-20 lg:px-8 lg:py-28 xl:py-32">
        <div class="max-w-3xl">
          <div class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.14em] text-gungnir-blue">
            <span class="h-px w-8 bg-gungnir-blue"></span>
            Native C++ web framework
          </div>

          <h1 class="max-w-[13ch] text-5xl font-bold leading-[0.96] tracking-[-0.055em] text-gungnir-ink dark:text-gungnir-dark-text sm:text-6xl lg:text-7xl xl:text-[5.15rem]">
            GUNGNIR is an expressive web framework built in C++.
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-8 text-gungnir-muted dark:text-gungnir-dark-muted sm:text-xl">
            Build structured applications with routing, controllers, models, validation, views, security, and application services without giving up native C++.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/docs/getting-started/" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-gungnir-blue px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-gungnir-blue-deep focus-visible:ring-4 focus-visible:ring-gungnir-blue/15">
              Get started
              <span class="ml-2" aria-hidden="true">→</span>
            </a>
            <a href="/docs/" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gungnir-line bg-white px-5 text-sm font-semibold text-gungnir-ink transition hover:border-gungnir-silver hover:bg-gungnir-silver-soft dark:border-gungnir-dark-line dark:bg-gungnir-dark-soft dark:text-gungnir-dark-text dark:hover:border-gungnir-silver/35 dark:hover:bg-gungnir-dark-elevated">
              Documentation
            </a>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-semibold text-gungnir-muted dark:text-gungnir-dark-muted">
            <span>Convention-first</span>
            <span class="h-1 w-1 rounded-full bg-gungnir-silver"></span>
            <span>Native runtime</span>
            <span class="h-1 w-1 rounded-full bg-gungnir-silver"></span>
            <span>Explicit async</span>
          </div>
        </div>

        <div class="relative lg:pl-4">
          <div class="absolute -inset-4 -z-10 border border-gungnir-line bg-gungnir-silver-soft dark:border-gungnir-dark-line dark:bg-gungnir-dark-soft"></div>
          <div class="overflow-hidden rounded-lg border border-black/80 bg-gungnir-ink shadow-2xl shadow-black/10">
            <div class="flex min-h-11 items-center justify-between border-b border-white/10 px-4">
              <span class="font-mono text-[10px] font-bold tracking-[0.1em] text-gungnir-silver">GNR</span>
              <span class="font-mono text-[11px] text-gungnir-silver">app/controllers/user_controller.gnr</span>
            </div>
            <pre class="overflow-x-auto p-5 text-[13px] leading-7 text-white sm:p-7 sm:text-sm"><code>{controllerExample}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-gungnir-line bg-gungnir-silver-soft/45 dark:border-gungnir-dark-line dark:bg-gungnir-dark-soft/55">
      <div class="mx-auto w-full max-w-[1440px] px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:gap-16">
          <div class="max-w-md">
            <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.14em] text-gungnir-blue">
              <span class="h-px w-7 bg-gungnir-blue"></span>
              Framework conventions
            </p>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] text-gungnir-ink dark:text-gungnir-dark-text sm:text-4xl">
              Build the application, not the plumbing.
            </h2>
            <p class="mt-5 text-base leading-7 text-gungnir-muted dark:text-gungnir-dark-muted">
              Common web concerns have predictable homes and consistent APIs so application code stays focused on application behavior.
            </p>
          </div>

          <div class="grid gap-px overflow-hidden rounded-lg border border-gungnir-line bg-gungnir-line dark:border-gungnir-dark-line dark:bg-gungnir-dark-line sm:grid-cols-2">
            {features.map(([number, title, description]) => (
              <article class="group bg-white p-6 transition hover:bg-gungnir-silver-soft/60 dark:bg-gungnir-dark dark:hover:bg-gungnir-dark-elevated sm:p-7">
                <div class="flex items-start gap-4">
                  <span class="mt-0.5 font-mono text-xs font-bold text-gungnir-blue">{number}</span>
                  <div>
                    <h3 class="text-base font-semibold text-gungnir-ink dark:text-gungnir-dark-text">{title}</h3>
                    <p class="mt-2 text-sm leading-6 text-gungnir-muted dark:text-gungnir-dark-muted">{description}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white dark:bg-gungnir-dark">
      <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-4 py-16 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 lg:py-20">
        <div class="max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gungnir-blue">Documentation</p>
          <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-gungnir-ink dark:text-gungnir-dark-text">Start with one route.</h2>
          <p class="mt-3 text-base leading-7 text-gungnir-muted dark:text-gungnir-dark-muted">
            Install Gungnir, understand the project structure, then move directly into routing, controllers, and models.
          </p>
        </div>
        <a href="/docs/getting-started/" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg border border-gungnir-ink bg-gungnir-ink px-5 text-sm font-semibold text-white transition hover:border-gungnir-blue hover:bg-gungnir-blue">
          Open installation guide
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
