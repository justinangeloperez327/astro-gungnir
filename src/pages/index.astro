---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => base + path.replace(/^\/+/, '');
---

<BaseLayout>
  <main>
    <section class="hero">
      <div class="shell hero-grid">
        <div>
          <div class="eyebrow">C++ Web Framework</div>
          <h1>Expressive web development, built in C++.</h1>
          <p class="hero-copy">
            Gungnir gives C++ web applications clear conventions for routing, controllers,
            models, validation, views, authentication, queues, mail, and the rest of the
            application lifecycle.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={withBase('/docs/getting-started/')}>Get Started</a>
            <a class="button secondary" href={withBase('/docs/')}>Read the Documentation</a>
          </div>
        </div>

        <div class="hero-code" aria-label="Gungnir code example">
          <div class="hero-code-header">app/controllers/user_controller.gnr</div>
          <pre><code>controller UserController
{
    Response index()
    {
        const users = User::all();

        return view("users/index", {
            "users": users
        });
    }
}</code></pre>
        </div>
      </div>
    </section>

    <section class="feature-section">
      <div class="shell">
        <div class="section-heading">
          <div class="eyebrow">Application-first conventions</div>
          <h2>Build the application, not the plumbing.</h2>
          <p>
            Gungnir organizes common web development concerns behind a consistent,
            convention-first API while retaining native C++ interoperability.
          </p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <h3>Routing & Controllers</h3>
            <p>Map requests to controller actions with route parameters, middleware, and async actions.</p>
          </article>
          <article class="feature-card">
            <h3>Models & ORM</h3>
            <p>Use expressive models, query methods, relationships, eager loading, timestamps, and soft deletes.</p>
          </article>
          <article class="feature-card">
            <h3>Database</h3>
            <p>Work with migrations and database abstractions across PostgreSQL, MySQL, SQL Server, and MongoDB adapters.</p>
          </article>
          <article class="feature-card">
            <h3>Validation</h3>
            <p>Validate request data directly in controller workflows using concise rule declarations.</p>
          </article>
          <article class="feature-card">
            <h3>Views</h3>
            <p>Render server-side HTML with escaped interpolation, loops, and direct model or collection data.</p>
          </article>
          <article class="feature-card">
            <h3>Application Services</h3>
            <p>Use authentication, authorization, sessions, cache, events, queues, mail, notifications, and scheduling.</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
