---
import BaseLayout from '../layouts/BaseLayout.astro';

const controllerExample = `controller UserController
{
    Response index()
    {
        const users = User::all();

        return view("users/index", {
            "users": users
        });
    }
}`;

const features = [
  ['01', 'Routing & Controllers', 'Map requests to focused controller actions with route parameters, middleware, and explicit async behavior.'],
  ['02', 'Models & ORM', 'Query records, define relationships, eager load data, and keep database access readable and predictable.'],
  ['03', 'Validation', 'Validate incoming data close to the request boundary before application or model code consumes it.'],
  ['04', 'Views', 'Render server-side HTML with escaped interpolation, loops, and model or collection data.'],
  ['05', 'Security', 'Handle sessions, authentication, authorization, CSRF protection, and request-level security concerns.'],
  ['06', 'Application Services', 'Coordinate events, queues, mail, notifications, cache, and scheduled work through explicit services.'],
];
---

<BaseLayout>
  <main id="main-content">
    <section class="relative overflow-hidden border-b border-gungnir-line bg-white">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -left-24 top-8 h-72 w-72 rounded-full bg-gungnir-blue/8 blur-3xl"></div>
        <div class="absolute right-0 top-0 h-80 w-80 bg-gungnir-silver-soft"></div>
      </div>

      <div class="relative mx-auto grid w-full max-w-[1440px] items-center gap-14 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.08fr_.92fr] lg:gap-20 lg:px-8 lg:py-28 xl:py-32">
        <div class="max-w-3xl">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-gungnir-line bg-white px-3 py-1.5 text-xs font-bold uppercase tracking-[0.13em] text-gungnir-blue shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-gungnir-blue"></span>
            C++ Web Framework
          </div>

          <h1 class="max-w-[12ch] text-5xl font-bold leading-[0.96] tracking-[-0.055em] text-gungnir-ink sm:text-6xl lg:text-7xl xl:text-[5.4rem]">
            Expressive web development, built in C++.
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-8 text-gungnir-muted sm:text-xl">
            Gungnir gives C++ applications a clear, convention-first web framework for routing, controllers, models, validation, views, security, and application services.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href="/docs/getting-started/"
              class="inline-flex min-h-12 items-center justify-center rounded-lg bg-gungnir-blue px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-gungnir-blue-deep focus-visible:ring-4 focus-visible:ring-gungnir-blue/15"
            >
              Get started
              <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
            <a
              href="/docs/"
              class="inline-flex min-h-12 items-center justify-center rounded-lg border border-gungnir-line bg-white px-5 text-sm font-semibold text-gungnir-ink transition hover:border-gungnir-silver hover:bg-gungnir-silver-soft"
            >
              Read documentation
            </a>
          </div>

          <p class="mt-5 text-xs font-medium text-gungnir-muted">
            Application-first conventions · Native C++ runtime · Explicit async behavior
          </p>
        </div>

        <div class="relative lg:pl-4">
          <div class="absolute -inset-4 -z-10 rounded-3xl bg-gungnir-silver-soft"></div>
          <div class="overflow-hidden rounded-2xl border border-black/80 bg-gungnir-ink shadow-2xl shadow-black/10">
            <div class="flex min-h-12 items-center justify-between border-b border-white/10 px-5">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
              </div>
              <span class="font-mono text-[11px] text-gungnir-silver">app/controllers/user_controller.gnr</span>
            </div>
            <pre class="overflow-x-auto p-5 text-[13px] leading-7 text-white sm:p-7 sm:text-sm"><code>{controllerExample}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-gungnir-line bg-gungnir-silver-soft/45">
      <div class="mx-auto w-full max-w-[1440px] px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:gap-16">
          <div class="max-w-md">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-gungnir-blue">Framework conventions</p>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] text-gungnir-ink sm:text-4xl">
              Build the application, not the plumbing.
            </h2>
            <p class="mt-5 text-base leading-7 text-gungnir-muted">
              The framework gives common web concerns predictable homes and consistent APIs, so application code stays focused on application behavior.
            </p>
          </div>

          <div class="grid gap-px overflow-hidden rounded-2xl border border-gungnir-line bg-gungnir-line sm:grid-cols-2">
            {features.map(([number, title, description]) => (
              <article class="group bg-white p-6 transition hover:bg-gungnir-silver-soft/60 sm:p-7">
                <div class="flex items-start gap-4">
                  <span class="mt-0.5 font-mono text-xs font-bold text-gungnir-blue">{number}</span>
                  <div>
                    <h3 class="text-base font-semibold text-gungnir-ink">{title}</h3>
                    <p class="mt-2 text-sm leading-6 text-gungnir-muted">{description}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-4 py-16 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8 lg:py-20">
        <div class="max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gungnir-blue">Documentation</p>
          <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-gungnir-ink">Start with one route.</h2>
          <p class="mt-3 text-base leading-7 text-gungnir-muted">
            Follow the installation guide, understand the project structure, then move directly into routing, controllers, and models.
          </p>
        </div>
        <a href="/docs/getting-started/" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg border border-gungnir-ink bg-gungnir-ink px-5 text-sm font-semibold text-white transition hover:bg-gungnir-blue">
          Open installation guide
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
