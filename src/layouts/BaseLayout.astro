---
import '../styles/global.css';
import DocsHeader from '../components/docs/DocsHeader.astro';

interface Props {
  title?: string;
  description?: string;
  docs?: boolean;
}

const {
  title = 'Gungnir',
  description = 'Gungnir is an expressive web framework built in C++.',
  docs = false,
} = Astro.props;

const pageTitle = title === 'Gungnir' ? title : `${title} · Gungnir`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#145DA0" />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="sr-only fixed left-4 top-4 z-[100] rounded-lg bg-gungnir-blue px-4 py-2 text-sm font-semibold text-white shadow-lg focus:not-sr-only">
      Skip to content
    </a>

    {docs ? (
      <DocsHeader />
    ) : (
      <header class="sticky top-0 z-50 border-b border-gungnir-line bg-white/95 backdrop-blur-xl">
        <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center gap-4 px-4 sm:px-6 lg:px-8">
          <a href="/" class="inline-flex shrink-0 items-center" aria-label="Gungnir home">
            <img class="h-9 w-auto max-w-44 object-contain sm:max-w-48" src="/images/logo-alt.png" alt="Gungnir" />
          </a>
          <nav class="ml-auto flex items-center gap-1 sm:gap-2" aria-label="Primary navigation">
            <a href="/docs/" class="inline-flex min-h-11 items-center rounded-lg px-3.5 text-sm font-semibold text-gungnir-ink transition hover:bg-gungnir-silver-soft hover:text-gungnir-blue">Documentation</a>
            <a href="https://github.com/justinangeloperez327/gungnir" class="hidden min-h-11 items-center rounded-lg px-3.5 text-sm font-semibold text-gungnir-ink transition hover:bg-gungnir-silver-soft hover:text-gungnir-blue sm:inline-flex">GitHub</a>
          </nav>
        </div>
      </header>
    )}

    <slot />

    <footer class="mt-auto border-t border-gungnir-line bg-white">
      <div class="mx-auto flex min-h-24 w-full max-w-[1440px] flex-col justify-center gap-4 px-4 py-6 text-sm text-gungnir-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <img class="h-7 w-auto max-w-36 object-contain" src="/images/logo-alt.png" alt="Gungnir" />
        <span>Expressive web development in C++.</span>
      </div>
    </footer>
  </body>
</html>
