---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import bodyFont from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import "../styles/global.css";
import DocsHeader from "../components/docs/DocsHeader.astro";
import { Image } from "astro:assets";
import logo from "../../public/images/logo-alt.png";
interface Props {
  title?: string;
  description?: string;
  docs?: boolean;
}
const {
  title = "Gungnir",
  description = "An expressive C++23 web framework for APIs, server-rendered web apps and backend services.",
  docs = false,
} = Astro.props;
const pageTitle =
  title === "Gungnir"
    ? "Gungnir — The expressive C++23 web framework"
    : `${title} · Gungnir`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#10131a" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const key = "gungnir-theme";
        const apply = (theme) => {
          const dark = theme !== "light";
          const root = document.documentElement;
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? "#10131a" : "#ffffff");
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            const label = dark ? "Switch to light mode" : "Switch to dark mode";
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          });
        };
        let saved;
        try {
          saved = localStorage.getItem(key);
        } catch {}
        apply(saved);
        document.addEventListener("click", (event) => {
          if (
            !(event.target instanceof Element) ||
            !event.target.closest("[data-theme-toggle]")
          )
            return;
          const theme = document.documentElement.classList.contains("dark")
            ? "light"
            : "dark";
          apply(theme);
          try {
            localStorage.setItem(key, theme);
          } catch {}
        });
        document.addEventListener(
          "DOMContentLoaded",
          () =>
            apply(
              document.documentElement.classList.contains("dark")
                ? "dark"
                : "light",
            ),
          { once: true },
        );
        window.addEventListener("storage", (event) => {
          if (event.key === key || event.key === null) apply(event.newValue);
        });
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <DocsHeader docs={docs} />
    <slot />
    <footer class="site-footer">
      <div class="site-container footer-inner">
        <div>
          <a href="/" aria-label="Gungnir home">
            <Image
              src={logo}
              width={148}
              format="webp"
              alt="Gungnir"
              class="brand-logo"
              loading="lazy"
            />
          </a>
          <p>
            Expressive web development.
            <br />
            Native applications.
          </p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/docs/getting-started/">Get started</a>
          <a href="/docs/">Documentation</a>
          <a href="https://github.com/justinangeloperez327/gungnir">GitHub ↗</a>
          <a href="https://github.com/justinangeloperez327/gungnir/releases">
            Releases ↗
          </a>
        </nav>
        <span class="footer-signature">Gungnir · C++23</span>
      </div>
    </footer>
  </body>
</html>
