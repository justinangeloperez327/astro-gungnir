---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsToc from "../components/docs/DocsToc.astro";
import MobileDocsNav from "../components/docs/MobileDocsNav.astro";
import PrevNext from "../components/docs/PrevNext.astro";
import CodeEnhancer from "../components/docs/CodeEnhancer.astro";
import source from "../data/gungnir-source.json";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<"docs">;
  docs: CollectionEntry<"docs">[];
  headings: Heading[];
  previous?: CollectionEntry<"docs"> | null;
  next?: CollectionEntry<"docs"> | null;
}

const { entry, docs, headings, previous, next } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  docs={true}
>
  <div class="docs-shell">
    <div class="docs-grid">
      <aside class="docs-sidebar">
        <DocsSidebar docs={docs} currentSlug={entry.data.slug} />
      </aside>

      <main id="main-content" class="docs-main">
        <MobileDocsNav docs={docs} currentSlug={entry.data.slug} />

        <nav class="doc-breadcrumb" aria-label="Breadcrumb">
          <a href="/docs/" class="breadcrumb-link">
            Documentation
          </a>
          <span class="breadcrumb-divider" aria-hidden="true">
            /
          </span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>

        <article class="docs-content" data-doc-content data-pagefind-body>
          <header class="doc-header">
            <div class="docs-category-row">
              <span class="docs-category">{entry.data.group}</span>
            </div>
            <h1>{entry.data.title}</h1>
            <p class="guide-description">{entry.data.description}</p>
          </header>

          <slot />

          <p class="guide-source" data-pagefind-ignore>
            {entry.data.sourcePath && (
              <a
                href={`https://github.com/${source.repository}/blob/${source.commit}/${entry.data.sourcePath}`}
              >
                View framework guide
              </a>
            )}
          </p>

          <PrevNext previous={previous} next={next} />
        </article>

        <CodeEnhancer />
      </main>

      <aside class="docs-toc">
        <DocsToc headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>
