---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsToc from '../components/docs/DocsToc.astro';
import MobileDocsNav from '../components/docs/MobileDocsNav.astro';
import PrevNext from '../components/docs/PrevNext.astro';
import CodeEnhancer from '../components/docs/CodeEnhancer.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'docs'>;
  docs: CollectionEntry<'docs'>[];
  headings: Heading[];
  previous?: CollectionEntry<'docs'> | null;
  next?: CollectionEntry<'docs'> | null;
}

const { entry, docs, headings, previous, next } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description} docs={true}>
  <div class="bg-white">
    <div class="mx-auto grid w-full max-w-[1536px] grid-cols-1 px-4 sm:px-6 lg:grid-cols-[248px_minmax(0,760px)] lg:gap-12 lg:px-8 xl:grid-cols-[248px_minmax(0,780px)_200px] xl:gap-14 2xl:gap-16">
      <aside class="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto py-9 pr-3 lg:block">
        <DocsSidebar docs={docs} currentSlug={entry.data.slug} />
      </aside>

      <main id="main-content" class="min-w-0 py-8 sm:py-10 lg:py-12">
        <MobileDocsNav docs={docs} currentSlug={entry.data.slug} />

        <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-gungnir-muted" aria-label="Breadcrumb">
          <a href="/docs/" class="text-gungnir-blue no-underline transition hover:text-gungnir-blue-deep">Documentation</a>
          <span class="text-gungnir-silver" aria-hidden="true">/</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>

        <article class="docs-content max-w-[72ch]" data-doc-content data-pagefind-body>
          <header class="mb-10">
            <div class="mb-3 flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.13em] text-gungnir-blue">
                <span class="h-px w-6 bg-gungnir-blue"></span>
                {entry.data.group}
              </span>
              {entry.data.status === 'preview' && (
                <span class="rounded border border-gungnir-line bg-gungnir-silver-soft px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-gungnir-muted">Preview</span>
              )}
            </div>
            <h1 class="text-4xl font-bold tracking-[-0.04em] text-gungnir-ink sm:text-5xl">{entry.data.title}</h1>
            <p class="mt-5 max-w-[66ch] text-base leading-7 text-gungnir-muted sm:text-[1.08rem] sm:leading-8">{entry.data.description}</p>
          </header>

          <slot />

          <PrevNext previous={previous} next={next} />
        </article>

        <CodeEnhancer />
      </main>

      <aside class="sticky top-24 hidden max-h-[calc(100vh-7rem)] overflow-y-auto py-12 xl:block">
        <DocsToc headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>
