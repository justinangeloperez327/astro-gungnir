---
interface Props {
  type?: "note" | "tip" | "warning" | "important" | "security";
  title?: string;
}

const { type = "note", title } = Astro.props;
const defaultTitles = {
  note: "Note",
  tip: "Tip",
  warning: "Warning",
  important: "Important",
  security: "Security",
};
---

<aside
  class="callout"
  data-type={type}
  role={type === "warning" || type === "security" ? "alert" : undefined}
>
  <p class="callout-title">{title ?? defaultTitles[type]}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>
