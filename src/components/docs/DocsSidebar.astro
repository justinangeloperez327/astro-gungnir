---
import type { CollectionEntry } from "astro:content";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props;

const hrefFor = (entry: CollectionEntry<"docs">) =>
  entry.data.slug ? `/docs/${entry.data.slug}/` : "/docs/";

const groups = docs.reduce((acc, entry) => {
  const group = acc.get(entry.data.group) ?? [];
  group.push(entry);
  acc.set(entry.data.group, group);
  return acc;
}, new Map<string, CollectionEntry<"docs">[]>());
---

<nav class="docs-nav" aria-label="Documentation navigation">
  {[...groups.entries()].map(([label, entries]) => (
    <section>
      <h2 class="docs-nav-group">{label}</h2>
      <div class="docs-nav-links">
        {entries.map((entry) => {
          const active = entry.data.slug === currentSlug;
          return (
            <a
              class:list={["docs-nav-link", active && "docs-nav-active"]}
              href={hrefFor(entry)}
              aria-current={active ? "page" : undefined}
            >
              {entry.data.title}
            </a>
          );
        })}
      </div>
    </section>
  ))}
</nav>
