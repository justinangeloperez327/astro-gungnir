---
import type { CollectionEntry } from "astro:content";
import DocsSidebar from "./DocsSidebar.astro";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props;
---

<div class="mobile-docs">
  <button
    type="button"
    class="mobile-nav-open"
    data-mobile-nav-open
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="mobile-docs-nav"
  >
    <span>Browse documentation</span>
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <dialog
    id="mobile-docs-nav"
    aria-labelledby="mobile-nav-title"
    class="mobile-nav-dialog"
    data-mobile-nav-dialog
  >
    <div class="mobile-nav-inner">
      <div class="mobile-nav-header">
        <span id="mobile-nav-title" class="mobile-nav-title">
          Documentation
        </span>
        <button
          type="button"
          class="icon-button"
          data-mobile-nav-close
          aria-label="Close documentation navigation"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="mobile-nav-body">
        <DocsSidebar docs={docs} currentSlug={currentSlug} />
      </div>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-mobile-nav-dialog]");
    const openButton = document.querySelector("[data-mobile-nav-open]");
    const closeButton = document.querySelector("[data-mobile-nav-close]");
    if (!dialog) return;
    openButton?.addEventListener("click", () => {
      dialog.showModal();
      openButton.setAttribute("aria-expanded", "true");
    });
    dialog.addEventListener("close", () => {
      openButton?.setAttribute("aria-expanded", "false");
      openButton?.focus();
    });
    closeButton?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
