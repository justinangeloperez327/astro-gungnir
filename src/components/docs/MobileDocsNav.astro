---
import type { CollectionEntry } from 'astro:content';
import DocsSidebar from './DocsSidebar.astro';

interface Props {
  docs: CollectionEntry<'docs'>[];
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props;
---

<div class="lg:hidden">
  <button type="button" class="mb-7 inline-flex h-11 w-full items-center justify-between rounded-lg border border-gungnir-line bg-gungnir-silver-soft px-4 text-sm font-semibold text-gungnir-ink" data-mobile-nav-open aria-haspopup="dialog" aria-controls="mobile-docs-nav">
    <span>Browse documentation</span>
    <svg class="h-4 w-4 text-gungnir-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <dialog id="mobile-docs-nav" class="m-0 ml-auto h-dvh w-[min(88vw,360px)] max-h-none max-w-none border-0 bg-white p-0 shadow-2xl backdrop:bg-gungnir-ink/40" data-mobile-nav-dialog>
    <div class="flex h-full flex-col">
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-gungnir-line px-4">
        <span class="text-sm font-bold text-gungnir-ink">Documentation</span>
        <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-gungnir-muted hover:bg-gungnir-silver-soft hover:text-gungnir-ink" data-mobile-nav-close aria-label="Close documentation navigation">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-3 py-5">
        <DocsSidebar docs={docs} currentSlug={currentSlug} />
      </div>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const dialog = document.querySelector('[data-mobile-nav-dialog]');
    const openButton = document.querySelector('[data-mobile-nav-open]');
    const closeButton = document.querySelector('[data-mobile-nav-close]');
    if (!dialog) return;
    openButton?.addEventListener('click', () => dialog.showModal());
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
