---
import type { CollectionEntry } from "astro:content";

interface Props {
  previous?: CollectionEntry<"docs"> | null;
  next?: CollectionEntry<"docs"> | null;
}

const { previous, next } = Astro.props;
const hrefFor = (entry: CollectionEntry<"docs">) =>
  entry.data.slug ? `/docs/${entry.data.slug}/` : "/docs/";
---

{(previous || next) && (
  <nav class="docs-pagination" aria-label="Documentation pagination">
    <div>
      {previous && (
        <a href={hrefFor(previous)} class="pagination-link">
          <span class="pagination-label">Previous</span>
          <span class="pagination-title">
            <span aria-hidden="true">←</span> {previous.data.title}
          </span>
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={hrefFor(next)} class="pagination-link pagination-next">
          <span class="pagination-label">Next</span>
          <span class="pagination-title">
            {next.data.title} <span aria-hidden="true">→</span>
          </span>
        </a>
      )}
    </div>
  </nav>
)}
