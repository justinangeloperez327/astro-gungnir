---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings = [] } = Astro.props as { headings: Heading[] };
const visible = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visible.length > 0 && (
  <nav aria-label="On this page">
    <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.13em] text-gungnir-muted/70">On this page</p>
    <div>
      {visible.map((heading) => (
        <a class:list={['docs-toc-link', heading.depth === 3 && 'toc-h3']} href={`#${heading.slug}`}>
          {heading.text}
        </a>
      ))}
    </div>
  </nav>
)}
