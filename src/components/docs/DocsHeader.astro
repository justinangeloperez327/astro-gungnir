---
import Search from "./Search.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import source from "../../data/gungnir-source.json";
import { Image } from "astro:assets";
import logo from "../../../public/images/logo-alt.png";
const { docs = false } = Astro.props;
---

<header class="site-header">
  <div
    class:list={["header-inner", docs ? "docs-header-inner" : "site-container"]}
  >
    <a href="/" class="brand-link" aria-label="Gungnir home">
      <Image
        src={logo}
        width={164}
        format="webp"
        alt="Gungnir"
        class="brand-logo"
        loading="eager"
      />
      <span class="brand-version">v{source.version}</span>
    </a>
    <nav class="header-links" aria-label="Primary navigation">
      <a href="/docs/" aria-current={docs ? "true" : undefined}>
        Documentation
      </a>
      <a href="https://github.com/justinangeloperez327/gungnir">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <div class="header-tools">
      <Search />
      <ThemeToggle />
    </div>
  </div>
</header>
