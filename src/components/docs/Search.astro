---
---

<div class="search">
  <button
    type="button"
    class="search-open"
    data-search-open
    aria-haspopup="dialog"
    aria-controls="docs-search-dialog"
    aria-label="Search documentation"
    aria-keyshortcuts="Control+K Meta+K /"
  >
    <svg
      class="h-4 w-4 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <span class="search-label">Search docs</span>
    <span class="search-shortcut" data-search-shortcut>
      Ctrl K
    </span>
  </button>

  <dialog
    id="docs-search-dialog"
    aria-label="Search documentation"
    class="search-dialog"
    data-search-dialog
  >
    <div class="search-input-row">
      <label class="search-input-wrap">
        <span class="sr-only">Search Gungnir documentation</span>
        <svg
          class="search-input-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          class="search-input"
          type="search"
          autocomplete="off"
          placeholder="Search routing, models, validation..."
          data-search-input
        />
        <button
          type="button"
          class="search-close icon-button"
          aria-label="Close search"
          data-search-close
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </label>
    </div>

    <div class="search-body">
      <div
        class="search-empty"
        data-search-empty
        role="status"
        aria-live="polite"
      >
        <p class="search-result-title">Search the Gungnir documentation</p>
        <p class="search-result-excerpt">
          Results include matching pages and sections.
        </p>
      </div>
      <div class="search-results" data-search-results></div>
    </div>

    <div class="search-footer">
      <span>↑ ↓ navigate · Enter open</span>
      <span>Esc close</span>
    </div>
  </dialog>
</div>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-search-dialog]");
    const input = document.querySelector("[data-search-input]");
    const results = document.querySelector("[data-search-results]");
    const empty = document.querySelector("[data-search-empty]");
    const opener = document.querySelector("[data-search-open]");
    const closeButton = document.querySelector("[data-search-close]");

    if (!dialog || !input || !results || !empty || !opener) return;

    const shortcut = document.querySelector("[data-search-shortcut]");
    if (shortcut && /Mac|iPhone|iPad/.test(navigator.platform))
      shortcut.textContent = "⌘ K";
    let pagefindPromise;
    let activeIndex = -1;
    let revision = 0;

    const loadPagefind = async () => {
      pagefindPromise ??= import("/pagefind/pagefind.js").then(
        async (pagefind) => {
          await pagefind.init();
          return pagefind;
        },
      );
      return pagefindPromise;
    };

    const open = async () => {
      if (!dialog.open) dialog.showModal();
      requestAnimationFrame(() => input.focus());
      try {
        await loadPagefind();
      } catch {
        empty.innerHTML =
          '<p class="search-result-title">Search index unavailable</p><p class="search-result-excerpt">Browse the guides or try searching again later.</p>';
      }
    };

    const close = () => {
      revision++;
      dialog.close();
      opener.focus();
      input.value = "";
      results.replaceChildren();
      empty.hidden = false;
      activeIndex = -1;
    };

    const setActive = (index) => {
      const links = [...results.querySelectorAll("a")];
      if (!links.length) return;
      activeIndex = Math.max(0, Math.min(index, links.length - 1));
      links.forEach((link, i) =>
        link.classList.toggle("search-result-active", i === activeIndex),
      );
      links[activeIndex].scrollIntoView({ block: "nearest" });
    };

    const renderResults = async (query) => {
      const currentRevision = ++revision;
      if (query.trim().length < 2) {
        results.replaceChildren();
        empty.hidden = false;
        empty.innerHTML =
          '<p class="search-result-title">Keep typing</p><p class="search-result-excerpt">Enter at least two characters to search.</p>';
        return;
      }

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.debouncedSearch(query, {}, 180);
        if (!search || currentRevision !== revision || !dialog.open) return;

        const pages = await Promise.all(
          search.results.slice(0, 8).map((result) => result.data()),
        );
        if (currentRevision !== revision || !dialog.open) return;
        results.replaceChildren();
        activeIndex = -1;

        const items = pages
          .flatMap((page) => {
            const sections = page.sub_results?.length
              ? page.sub_results.slice(0, 3)
              : [];
            return sections.length
              ? sections.map((section) => ({
                  title: section.title || page.meta?.title || "Documentation",
                  url: section.url || page.url,
                  excerpt: section.excerpt || page.excerpt,
                }))
              : [
                  {
                    title: page.meta?.title || "Documentation",
                    url: page.url,
                    excerpt: page.excerpt,
                  },
                ];
          })
          .slice(0, 10);

        empty.hidden = items.length > 0;
        if (!items.length) {
          empty.innerHTML =
            '<p class="search-result-title">No results</p><p class="search-result-excerpt">Try a broader term or another API name.</p>';
          return;
        }

        items.forEach((item) => {
          const link = document.createElement("a");
          link.href = item.url;
          link.className = "search-result";
          const title = document.createElement("div");
          title.className = "search-result-title";
          title.textContent = item.title;
          const excerpt = document.createElement("div");
          excerpt.className = "search-result-excerpt";
          excerpt.innerHTML = item.excerpt || "";
          link.append(title, excerpt);
          results.append(link);
        });
      } catch {
        if (currentRevision !== revision || !dialog.open) return;
        results.replaceChildren();
        empty.hidden = false;
        empty.innerHTML =
          '<p class="search-result-title">Search is unavailable</p><p class="search-result-excerpt">Browse the guides or try searching again later.</p>';
      }
    };

    opener.addEventListener("click", open);
    closeButton?.addEventListener("click", close);
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });
    input.addEventListener("input", () => renderResults(input.value));

    input.addEventListener("keydown", (event) => {
      const links = [...results.querySelectorAll("a")];
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex <= 0 ? links.length - 1 : activeIndex - 1);
      } else if (
        event.key === "Enter" &&
        activeIndex >= 0 &&
        links[activeIndex]
      ) {
        event.preventDefault();
        links[activeIndex].click();
      }
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const typing =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target?.isContentEditable;
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        open();
      } else if (event.key === "/" && !typing) {
        event.preventDefault();
        open();
      }
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
  })();
</script>
