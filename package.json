{
  "name": "astro-gungnir",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/clean-build.mjs && astro build && pagefind --site dist && npm run docs:check -- --built",
